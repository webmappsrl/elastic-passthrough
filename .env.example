# Variabili attese dallo stack. Copiare in .env e valorizzare sulla macchina:
# .env non e' versionato e non deve esserlo.

# Password dell'utente "elastic" del nodo Elasticsearch.
# Senza, il container del nodo non parte.
ELASTIC_PASSWORD=

# Credenziali con cui il passthrough si autentica verso il nodo: index.js
# costruisce da solo l'header Basic a partire da questi due valori.
USERNAME=
PASSWORD=

# Porta di ascolto del passthrough dentro il container. Default: 3000.
PORT=
