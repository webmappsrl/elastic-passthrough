# Variabili attese dallo stack. Copiare in .env e valorizzare sulla macchina:
# .env non e' versionato e non deve esserlo.

# Password dell'utente "elastic" del nodo. Senza, il container non parte.
ELASTIC_PASSWORD=

# Credenziali con cui il passthrough si autentica verso il nodo, nella forma
# attesa dall'header Authorization Basic: base64 di "utente:password".
TOKEN=

# Porta di ascolto del passthrough dentro il container. Default: 3000.
PORT=
